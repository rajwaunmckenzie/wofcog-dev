---
import { site } from '../data/site';
const tel = site.phone.replace(/[^0-9]/g, '');
// Brand marks from Simple Icons (CC0), inlined so the footer loads no icon font.
const socials = [
  { label: 'Facebook', href: site.facebook, path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z' },
  { label: 'YouTube', href: site.youtube, path: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
];
---
<footer class="bg-wine-dark py-12 text-cream">
  <div class="container-shell grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
    <div><p class="font-display text-2xl font-bold">{site.name}</p><p class="mt-2 text-cream/75">A Pentecostal church in Neptune, New Jersey, and part of the {site.denomination.name}.</p><a class="btn btn-light mt-5 text-sm" href="/visit">Plan Your Visit</a></div>
    <nav aria-label="Footer"><p class="font-bold text-gold">Explore</p><ul class="mt-2 space-y-1">{site.nav.map(([label, href]) => <li><a class="hover:text-gold" href={href}>{label}</a></li>)}</ul></nav>
    <div><p class="font-bold text-gold">Visit</p><p class="mt-2">{site.service}</p><address class="not-italic">{site.address}</address><a class="mt-1 inline-block underline decoration-gold underline-offset-4 hover:text-gold" href={site.directions} target="_blank" rel="noopener noreferrer">Get directions</a></div>
    <div><p class="font-bold text-gold">Contact</p><ul class="mt-2 space-y-1"><li><a class="hover:text-gold" href={`tel:${tel}`}>{site.phone}</a></li><li><a class="break-all hover:text-gold" href={`mailto:${site.email}`}>{site.email}</a></li></ul></div>
    <div><p class="font-bold text-gold">Follow</p><ul class="mt-2 space-y-2">{socials.map((s) => <li><a class="inline-flex items-center gap-3 text-cream transition-colors hover:text-gold" href={s.href} target="_blank" rel="noopener"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>{s.label}</a></li>)}</ul></div>
  </div>
  <div class="container-shell mt-10 border-t border-white/15 pt-5 text-xs text-cream/60">© {new Date().getFullYear()} Word of Faith Church of God.</div>
</footer>
