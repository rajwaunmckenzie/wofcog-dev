---
import { site } from '../data/site';
const tel = site.phone.replace(/[^0-9]/g, '');
---
<footer class="bg-wine-dark py-12 text-cream">
  <div class="container-shell grid gap-8 md:grid-cols-4">
    <div><p class="font-display text-2xl font-bold">{site.name}</p><p class="mt-2 text-cream/75">A Pentecostal church in Neptune, New Jersey, and part of the {site.denomination.name}.</p><a class="btn btn-light mt-5 text-sm" href="/visit">Plan Your Visit</a></div>
    <div><p class="font-bold text-gold">Visit</p><p class="mt-2">{site.service}</p><address class="not-italic">{site.address}</address><a class="mt-1 inline-block underline decoration-gold underline-offset-4 hover:text-gold" href={site.directions} target="_blank" rel="noopener noreferrer">Get directions</a></div>
    <div><p class="font-bold text-gold">Contact</p><ul class="mt-2 space-y-1"><li><a class="hover:text-gold" href={`tel:${tel}`}>{site.phone}</a></li><li><a class="break-all hover:text-gold" href={`mailto:${site.email}`}>{site.email}</a></li></ul></div>
    <div><p class="font-bold text-gold">Follow</p><ul class="mt-2 space-y-1"><li><a class="hover:text-gold" href={site.facebook} target="_blank" rel="noopener">Facebook</a></li><li><a class="hover:text-gold" href={site.youtube} target="_blank" rel="noopener">YouTube</a></li></ul></div>
  </div>
  <div class="container-shell mt-10 border-t border-white/15 pt-5 text-xs text-cream/60">© {new Date().getFullYear()} Word of Faith Church of God.</div>
</footer>
