---
import { site } from '../data/site';
---
<footer class="bg-wine-dark py-12 text-cream">
  <div class="container-shell grid gap-8 md:grid-cols-3">
    <div><p class="font-display text-2xl font-bold">{site.name}</p><p class="mt-2 text-cream/75">A place to worship, grow in faith, and find community.</p></div>
    <div><p class="font-bold text-gold">Visit</p><p class="mt-2">{site.service}</p><p>{site.address}</p></div>
    <div><p class="font-bold text-gold">Contact</p><p class="mt-2">{site.phone}</p><p>{site.email}</p></div>
  </div>
  <div class="container-shell mt-10 border-t border-white/15 pt-5 text-xs text-cream/60">© {new Date().getFullYear()} Word of Faith Church of God.</div>
</footer>
