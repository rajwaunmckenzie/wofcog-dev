---
// Closing call to action: every page ends with the next step toward visiting.
import { site } from '../data/site';
const { title = 'Come worship with us this Sunday.' } = Astro.props;
---
<section class="bg-wine-dark py-16 text-cream">
  <div class="container-shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div><h2 class="font-display text-3xl font-bold">{title}</h2><p class="mt-2 text-cream/75">{site.service} at {site.address}</p></div>
    <div class="flex flex-wrap gap-3"><a class="btn btn-light" href="/visit">Plan Your Visit</a><a class="btn btn-outline-light" href={site.directions} target="_blank" rel="noopener noreferrer">Get directions</a></div>
  </div>
</section>
