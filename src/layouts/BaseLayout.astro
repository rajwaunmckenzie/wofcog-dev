---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { churchJsonLd, indexable, origin } from '../lib/seo';
import sharePhoto from '../assets/leadership/bishop-first-lady-white-wide.jpg';

interface Props { title?: string; description?: string; noindex?: boolean }
const {
  noindex = false,
  title = 'Word of Faith Church of God | Pentecostal Church in Neptune, NJ',
  description = site.description,
} = Astro.props;

// Canonical URLs have no trailing slash, matching the links in the nav.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(path, site.url).href;
const share = await getImage({ src: sharePhoto, width: 600, height: 315, fit: 'cover', format: 'jpg' });
const shareImage = new URL(share.src, origin).href;
const robots = noindex || !indexable ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#701D2E" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content="600" />
  <meta property="og:image:height" content="315" />
  <meta property="og:image:alt" content="Bishop Alexander McKenzie and Co-Pastor Jossett O. McKenzie of Word of Faith Church of God" />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={JSON.stringify(churchJsonLd(shareImage))} />
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:bg-white focus:p-3">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
