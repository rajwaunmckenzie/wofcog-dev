---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Plan Your Visit | Word of Faith Church of God"><section class="py-20"><div class="container-shell grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">Plan your visit</p><h1 class="mt-3 font-display text-5xl font-bold text-wine-dark">We'd be glad to worship with you.</h1><p class="mt-6 text-lg leading-8 text-stone-700">Sunday worship begins at 11:30 AM. Come ready for worship, the Word, fellowship, and a community seeking to grow in faith together.</p></div><aside class="card p-7"><h2 class="text-2xl font-bold text-wine-dark">Sunday Worship</h2><p class="mt-4">{site.service}</p><p class="mt-2">{site.address}</p><p class="mt-6"><strong>Phone:</strong> {site.phone}<br/><strong>Email:</strong> {site.email}</p></aside></div></section>
<section id="prayer" class="scroll-mt-24 bg-white py-20"><div class="container-shell max-w-4xl"><p class="eyebrow">Prayer request</p><h2 class="mt-3 font-display text-4xl font-bold text-wine-dark">How can we pray for you?</h2><p class="mt-5 text-lg leading-8 text-stone-700">We would be honored to pray with you. Until our online prayer form is ready, please call the church or send your request by email.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href={`mailto:${site.email}?subject=Prayer%20Request`}>Email a prayer request</a><a class="btn border border-wine/30 text-wine-dark" href={`tel:${site.phone.replace(/[^0-9]/g,'')}`}>Call {site.phone}</a></div></div></section></BaseLayout>
