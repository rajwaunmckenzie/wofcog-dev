---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/leadership/bishop-first-lady-green-close.jpg';
import whiteStanding from '../assets/leadership/bishop-first-lady-white-standing.jpg';
import seated from '../assets/leadership/bishop-first-lady-seated.jpg';
import whiteClose from '../assets/leadership/bishop-first-lady-white-close.jpg';
import greenGlasses from '../assets/leadership/bishop-first-lady-green-glasses.jpg';
import whiteEmbrace from '../assets/leadership/bishop-first-lady-white-embrace.jpg';
import greenWide from '../assets/leadership/bishop-first-lady-green-glasses-wide.jpg';
import whiteWide from '../assets/leadership/bishop-first-lady-white-hand.jpg';

const leaders = 'Bishop Alexander McKenzie and First Lady Jossett O. McKenzie';
const gallery = [
  { src: whiteStanding, class: 'md:row-span-2' },
  { src: greenWide, class: 'col-span-2', pos: 'object-[center_30%]' },
  { src: whiteClose, class: '' },
  { src: greenGlasses, class: 'md:row-span-2' },
  { src: whiteWide, class: 'col-span-2', pos: 'object-[center_30%]' },
  { src: whiteEmbrace, class: 'col-span-2', pos: 'object-[center_25%]' },
  { src: seated, class: '', pos: 'object-top' },
];
---
<BaseLayout title="About | Word of Faith Church of God">
  <section class="py-20 sm:py-24"><div class="container-shell max-w-4xl">
    <p class="eyebrow">About WOF</p>
    <h1 class="mt-3 font-display text-5xl font-bold text-wine-dark sm:text-6xl">Worship. Scripture. Community. Service.</h1>
    <p class="mt-6 text-lg leading-8 text-stone-700">Word of Faith is a Pentecostal Christian church in Neptune, New Jersey, affiliated with the Church of God. Our mission is to glorify the Lord Jesus, equip the saints, and evangelize sinners.</p>
  </div></section>

  <section id="leadership" class="scroll-mt-24 overflow-hidden bg-sand/55 py-20 sm:py-28"><div class="container-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
    <div class="relative">
      <Image src={portrait} widths={[400, 600]} sizes="(min-width: 1024px) 480px, 100vw" alt={leaders} class="aspect-[4/5] w-full rounded-[2.5rem] object-cover shadow-2xl" />
      <div class="absolute -bottom-6 -right-3 bg-gold px-7 py-5 text-wine-dark shadow-xl"><p class="text-xs font-black uppercase tracking-[.18em]">Our Pastors</p><p class="mt-1 font-display text-2xl font-bold">The McKenzies</p></div>
    </div>
    <div class="lg:pl-8">
      <p class="eyebrow">Meet our leadership</p>
      <h2 class="mt-4 font-display text-5xl font-bold leading-tight text-wine-dark">Led with faith.<br/>Rooted in community.</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="border-l-2 border-gold pl-5"><p class="font-display text-2xl font-bold text-wine-dark">Bishop Alexander McKenzie</p><p class="mt-1 text-sm font-bold uppercase tracking-[.14em] text-wine">Bishop</p></div>
        <div class="border-l-2 border-gold pl-5"><p class="font-display text-2xl font-bold text-wine-dark">First Lady Jossett O. McKenzie</p><p class="mt-1 text-sm font-bold uppercase tracking-[.14em] text-wine">First Lady</p></div>
      </div>
      <p class="mt-8 text-lg leading-8 text-stone-700">Bishop and First Lady McKenzie serve Word of Faith with a heart for worship, spiritual growth, and community. Their full biographies will be added here once approved by church leadership.</p>
      <a class="btn btn-primary mt-8" href="/visit">Plan Your Visit</a>
    </div>
  </div></section>

  <section class="bg-white py-20 sm:py-28"><div class="container-shell">
    <p class="eyebrow">Our pastors</p>
    <h2 class="mt-3 font-display text-4xl font-bold text-wine-dark sm:text-5xl">Serving WOF together.</h2>
    <div class="mt-10 grid grid-flow-dense auto-rows-[160px] grid-cols-2 gap-3 sm:auto-rows-[220px] md:grid-cols-4">
      {gallery.map((photo) => (
        <div class:list={['group overflow-hidden rounded-3xl bg-sand', photo.class]}>
          <Image src={photo.src} widths={[400, 600]} sizes="(min-width: 768px) 25vw, 50vw" alt={leaders} loading="lazy" class:list={['h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]', photo.pos]} />
        </div>
      ))}
    </div>
  </div></section>

  <section class="py-20"><div class="container-shell max-w-4xl">
    <p class="eyebrow">Our story</p>
    <h2 class="mt-3 font-display text-3xl font-bold text-wine-dark">History</h2>
    <p class="mt-4 leading-7 text-stone-700">The story of Word of Faith will be added here after leadership review.</p>
    <h2 class="mt-12 font-display text-3xl font-bold text-wine-dark">What we believe</h2>
    <p class="mt-4 leading-7 text-stone-700">As a Church of God congregation, Word of Faith holds to the Church of God Declaration of Faith. Our local statement of faith will be published here once approved.</p>
  </div></section>
</BaseLayout>
