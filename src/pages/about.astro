---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/leadership/bishop-first-lady-green-close.jpg';
import whiteStanding from '../assets/leadership/bishop-first-lady-white-standing.jpg';
import seated from '../assets/leadership/bishop-first-lady-seated.jpg';
import whiteClose from '../assets/leadership/bishop-first-lady-white-close.jpg';
import greenGlasses from '../assets/leadership/bishop-first-lady-green-glasses.jpg';
import whiteEmbrace from '../assets/leadership/bishop-first-lady-white-embrace.jpg';
import greenWide from '../assets/leadership/bishop-first-lady-green-glasses-wide.jpg';
import whiteWide from '../assets/leadership/bishop-first-lady-white-hand.jpg';
import { history, leaders as bios } from '../data/story';
import { site } from '../data/site';

const leaders = 'Bishop Alexander McKenzie and First Lady Jossett O. McKenzie';
const gallery = [
  { src: whiteStanding, class: 'md:row-span-2' },
  { src: greenWide, class: 'col-span-2', pos: 'object-[center_30%]' },
  { src: whiteClose, class: '' },
  { src: greenGlasses, class: 'md:row-span-2' },
  { src: whiteWide, class: 'col-span-2', pos: 'object-[center_30%]' },
  { src: whiteEmbrace, class: 'col-span-2', pos: 'object-[center_25%]' },
  { src: seated, class: '', pos: 'object-top' },
];
---
<BaseLayout title="About Us & Our Pastors | Word of Faith Church of God, Neptune NJ" description="Meet Bishop Alexander McKenzie and Co-Pastor Jossett O. McKenzie, and read the story of Word of Faith, a Pentecostal Church of God congregation in Neptune, NJ.">
  <section class="py-20 sm:py-24"><div class="container-shell max-w-4xl">
    <p class="eyebrow">About WOF</p>
    <h1 class="mt-3 font-display text-5xl font-bold text-wine-dark sm:text-6xl">Worship. Scripture. Community. Service.</h1>
    <p class="mt-6 text-lg leading-8 text-stone-700">Word of Faith is a Pentecostal Christian church in Neptune, New Jersey, affiliated with the Church of God. Our mission is to glorify the Lord Jesus, equip the saints, and evangelize sinners.</p>
    <p class="mt-4 text-lg leading-8 text-stone-700">What began as a small gathering of believers in a living room has become a church home for people of every age. Wherever you are in your walk with Jesus, you are welcome here.</p>
    <div class="mt-8 flex flex-wrap gap-4 text-sm font-black"><a class="tap text-wine underline decoration-gold decoration-2 underline-offset-4" href="#leadership">Meet our pastors</a><a class="tap text-wine underline decoration-gold decoration-2 underline-offset-4" href="#story">Read our story</a></div>
  </div></section>

  <section id="leadership" class="scroll-mt-24 overflow-hidden bg-sand/55 py-20 sm:py-28"><div class="container-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
    <div class="relative">
      <Image src={portrait} widths={[400, 600]} sizes="(min-width: 1024px) 480px, 100vw" alt={leaders} class="aspect-[4/5] w-full rounded-[2.5rem] object-cover shadow-2xl" />
      <div class="absolute -bottom-6 right-3 max-w-[80%] bg-gold px-5 py-4 text-wine-dark shadow-xl sm:px-7 sm:py-5 lg:-right-3"><p class="text-xs font-black uppercase tracking-[.18em]">Our Pastors</p><p class="mt-1 font-display text-xl font-bold sm:text-2xl">The McKenzies</p></div>
    </div>
    <div class="lg:pl-8">
      <p class="eyebrow">Meet our leadership</p>
      <h2 class="mt-4 font-display text-5xl font-bold leading-tight text-wine-dark">Led with faith.<br/>Rooted in community.</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {bios.map((leader) => (
          <a href={`#${leader.id}`} class="group border-l-2 border-gold pl-5"><p class="font-display text-2xl font-bold text-wine-dark group-hover:text-wine">{leader.name}</p><p class="mt-1 text-sm font-bold uppercase tracking-[.14em] text-wine">{leader.role}</p></a>
        ))}
      </div>
      <p class="mt-8 text-lg leading-8 text-stone-700">Bishop McKenzie has served as Lead Pastor since 2006, and alongside Rev. McKenzie he has watched Word of Faith grow from eight committed members in 2009 to the church family it is today. Both have roots in St. Catherine, Jamaica, and both bring a pastor’s heart, a teacher’s love for the Word, and a warmth they love to share with every guest.</p>
      <a class="btn btn-primary mt-8" href="/visit">Plan Your Visit</a>
    </div>
  </div></section>

  <section class="bg-cream py-20 sm:py-28"><div class="container-shell grid gap-16">
    {bios.map((leader, i) => (
      <article id={leader.id} class="scroll-mt-24 grid gap-10 lg:grid-cols-[1.25fr_.75fr] lg:items-start">
        <div class:list={[i % 2 === 1 && 'lg:order-2']}>
          <p class="eyebrow">{leader.role}</p>
          <h2 class="mt-3 font-display text-4xl font-bold text-wine-dark sm:text-5xl">{leader.name}</h2>
          <p class="mt-3 font-display text-xl italic text-wine">{leader.tagline}</p>
          <div class="mt-8 grid gap-5 text-lg leading-8 text-stone-700">{leader.paragraphs.map((text) => <p>{text}</p>)}</div>
        </div>
        <aside class:list={['grid gap-5', i % 2 === 1 && 'lg:order-1']}>
          {leader.quote && <blockquote class="border-l-2 border-gold pl-6 font-display text-2xl font-bold leading-snug text-wine-dark">“{leader.quote}”</blockquote>}
          <figure class="rounded-3xl bg-wine p-7 text-white shadow-xl">
            <p class="text-xs font-black uppercase tracking-[.18em] text-gold">Favorite Scripture</p>
            <blockquote class="mt-4 font-display text-xl leading-relaxed">“{leader.scripture.text}”</blockquote>
            <figcaption class="mt-4 text-sm font-bold text-white/75">{leader.scripture.ref}</figcaption>
          </figure>
        </aside>
      </article>
    ))}
  </div></section>

  <section class="bg-white py-20 sm:py-28"><div class="container-shell">
    <p class="eyebrow">Our pastors</p>
    <h2 class="mt-3 font-display text-4xl font-bold text-wine-dark sm:text-5xl">Serving WOF together.</h2>
    <div class="mt-10 grid grid-flow-dense auto-rows-[160px] grid-cols-2 gap-3 sm:auto-rows-[220px] md:grid-cols-4">
      {gallery.map((photo) => (
        <div class:list={['group overflow-hidden rounded-3xl bg-sand', photo.class]}>
          <Image src={photo.src} widths={[400, 600]} sizes="(min-width: 768px) 25vw, 50vw" alt={leaders} loading="lazy" class:list={['h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]', photo.pos]} />
        </div>
      ))}
    </div>
  </div></section>

  <section class="py-20"><div class="container-shell max-w-4xl">
    <div id="story" class="scroll-mt-24">
      <p class="eyebrow">Our story</p>
      <h2 class="mt-3 font-display text-4xl font-bold text-wine-dark sm:text-5xl">From a living room to a church home.</h2>
      <p class="mt-6 text-lg leading-8 text-stone-700">{history.intro}</p>
      <ol class="mt-12 border-l-2 border-gold/60">
        {history.milestones.map((m) => (
          <li class="relative pb-10 pl-8 last:pb-0">
            <span class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-4 border-cream bg-gold" aria-hidden="true"></span>
            <p class="text-xs font-black uppercase tracking-[.18em] text-wine">{m.when}</p>
            <h3 class="mt-2 font-display text-2xl font-bold text-wine-dark">{m.title}</h3>
            <p class="mt-2 leading-7 text-stone-700">{m.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 rounded-3xl bg-sand/60 p-8">
        <p class="font-display text-2xl font-bold leading-snug text-wine-dark">{history.today}</p>
        <div class="mt-6 flex flex-wrap gap-3"><a class="btn btn-primary" href="/visit">Plan Your Visit</a><a class="btn border border-wine/30 text-wine-dark" href="/events">See what’s happening</a></div>
      </div>
    </div>
    <h2 class="mt-16 font-display text-3xl font-bold text-wine-dark">What we believe</h2>
    <p class="mt-4 leading-7 text-stone-700">As a Church of God congregation, Word of Faith holds to the <a class="font-bold text-wine underline decoration-gold decoration-2 underline-offset-4" href={site.denomination.declarationOfFaith} target="_blank" rel="noopener">Church of God Declaration of Faith</a>. Our local statement of faith will be published here once approved.</p>
  </div></section>
</BaseLayout>
