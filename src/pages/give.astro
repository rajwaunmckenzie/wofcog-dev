---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitCta from '../components/VisitCta.astro';
---
<BaseLayout title="Give | Word of Faith Church of God" description="Ways to give to Word of Faith Church of God in Neptune, NJ. Give in person during services."><section class="py-20"><div class="container-shell max-w-4xl"><p class="eyebrow">Give</p><h1 class="mt-3 font-display text-5xl font-bold text-wine-dark">Ways to give.</h1><div class="mt-10 grid gap-5 md:grid-cols-3"><article class="card p-6"><h2 class="text-xl font-bold text-wine-dark">Online</h2><p class="mt-3 text-stone-700">Secure giving provider to be selected by church leadership.</p></article><article class="card p-6"><h2 class="text-xl font-bold text-wine-dark">Zelle</h2><p class="mt-3 text-stone-700">Available today. Public payment details will be added only after leadership confirmation.</p></article><article class="card p-6"><h2 class="text-xl font-bold text-wine-dark">In person</h2><p class="mt-3 text-stone-700">Giving is also available during church services.</p></article></div></div></section><VisitCta /></BaseLayout>
