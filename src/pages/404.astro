---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitCta from '../components/VisitCta.astro';
---
<BaseLayout title="Page Not Found | Word of Faith Church of God" noindex>
  <section class="py-24"><div class="container-shell max-w-3xl text-center">
    <p class="eyebrow">Page not found</p>
    <h1 class="mt-3 font-display text-5xl font-bold text-wine-dark">We couldn't find that page.</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-stone-700">It may have moved when we updated our website. Here are the places most visitors are looking for.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3"><a class="btn btn-primary" href="/visit">Plan your visit</a><a class="btn border border-wine/30 text-wine-dark" href="/events">Events</a><a class="btn border border-wine/30 text-wine-dark" href="/media">Watch online</a><a class="btn border border-wine/30 text-wine-dark" href="/">Home</a></div>
  </div></section>
  <VisitCta />
</BaseLayout>
