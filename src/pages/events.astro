---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Events | Word of Faith Church of God"><section class="py-20"><div class="container-shell max-w-4xl"><p class="eyebrow">Church calendar</p><h1 class="mt-3 font-display text-5xl font-bold text-wine-dark">Upcoming events</h1><p class="mt-5 text-lg leading-8 text-stone-700">This page is prepared for a leadership-managed event source. Google Calendar and a lightweight CMS remain under evaluation. Until that integration is selected, no event dates will be invented.</p></div></section></BaseLayout>
