---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import CogEmblem from '../assets/brand/cog-emblem.svg';
import leadershipPhoto from '../assets/leadership/bishop-first-lady-green-glasses.jpg';
---
<BaseLayout>
  <section class="relative isolate min-h-[82vh] overflow-hidden bg-wine-dark text-white">
    <CogEmblem aria-hidden="true" class="pointer-events-none absolute bottom-6 right-4 h-auto w-[62%] max-w-[420px] text-cream opacity-20 lg:bottom-auto lg:right-[3%] lg:top-1/2 lg:w-[44%] lg:max-w-[760px] lg:-translate-y-1/2 lg:opacity-35" />
    <div class="absolute inset-0 bg-gradient-to-r from-wine-dark via-wine-dark/90 to-wine-dark/25"></div>
    <div class="absolute inset-0 cross-grid opacity-50"></div>
    <div class="container-shell relative flex min-h-[82vh] items-center py-20">
      <div class="reveal max-w-4xl">
        <p class="text-xs font-black uppercase tracking-[.22em] text-gold">Neptune, New Jersey • Sunday 11:30 AM</p>
        <h1 class="mt-6 font-display text-[clamp(3.7rem,8vw,7.8rem)] font-bold leading-[.86] tracking-[-.05em]">A place for<br/><em class="font-normal text-gold">faith to grow.</em></h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-white/80">Worship Jesus. Learn the Word. Find community. Put faith into action at Word of Faith Church of God.</p>
        <div class="mt-9 flex flex-wrap gap-3"><a class="btn btn-light" href="/visit">Plan Your Visit</a><a class="btn btn-outline-light" href="/media">Watch & Connect</a><a class="btn btn-outline-light" href="/visit#prayer">Request Prayer</a></div>
      </div>
    </div>
    <a href="#welcome" class="absolute bottom-8 right-8 hidden text-xs font-black uppercase tracking-[.2em] text-white/70 md:block">Discover WOF ↓</a>
  </section>

  <section id="welcome" class="bg-cream py-20 sm:py-28">
    <div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div><p class="eyebrow">Welcome to WOF</p><h2 class="mt-4 font-display text-4xl font-bold leading-tight text-wine-dark sm:text-6xl">Come as a visitor.<br/><span class="text-wine">Grow as family.</span></h2></div>
      <div class="border-l-2 border-gold pl-7 text-lg leading-8 text-stone-700"><p>Word of Faith is a Pentecostal church centered on worship, Scripture, fellowship, and service. Our story began with a small gathering of believers in a living room, and God has been growing this family ever since. Whether you are beginning your faith journey or looking for a church home, we invite you to experience WOF in person.</p><a href="/about#story" class="mt-5 inline-block font-black text-wine underline decoration-gold decoration-2 underline-offset-4">Read our story →</a></div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-wine py-20 text-white sm:py-28">
    <div class="drift absolute -left-24 top-0 font-display text-[20rem] font-bold leading-none text-white/[.035]" aria-hidden="true">MISSION</div>
    <div class="container-shell relative"><p class="text-xs font-black uppercase tracking-[.22em] text-gold">Our Mission</p><blockquote class="mt-6 max-w-5xl font-display text-4xl font-bold leading-[1.08] sm:text-6xl">{site.mission}</blockquote>
      <div class="mt-12 grid gap-px bg-white/15 md:grid-cols-3"><div class="bg-wine p-6"><span class="font-display text-5xl text-gold">01</span><h3 class="mt-4 text-xl font-black">Glorify the Lord Jesus</h3></div><div class="bg-wine p-6"><span class="font-display text-5xl text-gold">02</span><h3 class="mt-4 text-xl font-black">Equip the Saints</h3></div><div class="bg-wine p-6"><span class="font-display text-5xl text-gold">03</span><h3 class="mt-4 text-xl font-black">Evangelize Sinners</h3></div></div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-28"><div class="container-shell"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow">Gather with us</p><h2 class="mt-3 font-display text-5xl font-bold text-wine-dark">There's a place for you here.</h2></div><a href="/events" class="font-black text-wine underline decoration-gold decoration-2 underline-offset-4">See events →</a></div>
    <div class="mt-10 divide-y divide-wine/15 border-y border-wine/15">{site.gatherings.map((item,i) => <article class="grid gap-3 py-7 md:grid-cols-[70px_1fr_1fr] md:items-center"><span class="font-display text-3xl text-gold">0{i+1}</span><h3 class="font-display text-2xl font-bold text-wine-dark">{item.label}</h3><div class="md:text-right"><p class="font-bold text-wine">{item.schedule}</p><p class="text-sm text-stone-500">{item.mode}</p></div></article>)}</div>
  </div></section>

  <section class="overflow-hidden bg-sand/55 py-20 sm:py-28"><div class="container-shell grid gap-12 lg:grid-cols-[1.08fr_.92fr] lg:items-center">
    <div class="relative"><Image src={leadershipPhoto} widths={[400, 600]} sizes="(min-width: 1024px) 560px, 100vw" alt="Bishop Alexander McKenzie and First Lady Jossett O. McKenzie" class="aspect-[4/5] w-full rounded-[2.5rem] object-cover shadow-2xl"/><div class="absolute -bottom-6 right-3 max-w-[80%] bg-gold px-5 py-4 text-wine-dark shadow-xl sm:px-7 sm:py-5 lg:-right-3"><p class="text-xs font-black uppercase tracking-[.18em]">Leadership</p><p class="mt-1 font-display text-xl font-bold sm:text-2xl">Faithful. Present. Welcoming.</p></div></div>
    <div class="lg:pl-8"><p class="eyebrow">Meet our leadership</p><h2 class="mt-4 font-display text-5xl font-bold leading-tight text-wine-dark">Led with faith.<br/>Rooted in community.</h2><p class="mt-6 text-lg leading-8 text-stone-700">Bishop Alexander A. McKenzie, our Lead Pastor since 2006, once served in the Jamaica Constabulary Force and now calls himself “a cop for Christ.” Alongside him, Co-Pastor Rev. Jossett O. McKenzie teaches the Word with wisdom and compassion and serves in ministries from Sunday School to Community Outreach. Together they lead WOF with warmth, humor, and a genuine love for people.</p><a class="btn btn-primary mt-8" href="/about#leadership">Meet Our Leadership</a></div>
  </div></section>

  <section class="bg-wine-dark py-20 text-white sm:py-28"><div class="container-shell grid gap-8 lg:grid-cols-12">
    <div class="lg:col-span-7"><p class="text-xs font-black uppercase tracking-[.22em] text-gold">Watch • Pray • Connect</p><h2 class="mt-4 max-w-3xl font-display text-5xl font-bold sm:text-6xl">Church beyond Sunday morning.</h2><p class="mt-6 max-w-2xl text-lg leading-8 text-white/70">Connect with WOF through livestream and media, send a prayer request, or reach the church directly.</p></div>
    <div class="grid gap-3 lg:col-span-5"><a href="/media" class="group flex items-center justify-between border border-white/15 p-5 text-xl font-bold transition hover:bg-white hover:text-wine-dark"><span>Watch Media</span><span>↗</span></a><a href="/visit#prayer" class="group flex items-center justify-between border border-white/15 p-5 text-xl font-bold transition hover:bg-white hover:text-wine-dark"><span>Prayer Request</span><span>↗</span></a><a href="/give" class="group flex items-center justify-between border border-white/15 p-5 text-xl font-bold transition hover:bg-white hover:text-wine-dark"><span>Give</span><span>↗</span></a></div>
  </div></section>

  <section class="bg-cream py-20 sm:py-28"><div class="container-shell text-center"><p class="eyebrow">The next step is simple</p><h2 class="mx-auto mt-4 max-w-4xl font-display text-5xl font-bold leading-tight text-wine-dark sm:text-7xl">Come experience WOF for yourself.</h2><p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-stone-700">108 Fortunato Pl., Neptune, NJ 07753<br/>Sunday Worship • 11:30 AM</p><a class="btn btn-primary mt-8" href="/visit">Plan Your Visit</a></div></section>
</BaseLayout>
