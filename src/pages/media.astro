---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getVideos, players, videoEmbed, thumbnail } from '../lib/youtube';

const videos = await getVideos();
const views = [
  { key: 'latest', label: 'Latest videos', src: players.latest },
  { key: 'livestreams', label: 'Past livestreams', src: players.livestreams },
  { key: 'live', label: 'Live now', src: players.live },
];
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: site.calendar.timeZone });
// Facebook's Page Plugin renders at most 500px wide, so it sits centered on a sand band below the card's heading.
const facebookEmbed = `https://www.facebook.com/plugins/page.php?${new URLSearchParams({
  href: site.facebook, tabs: 'timeline', width: '500', height: '640',
  small_header: 'true', adapt_container_width: 'true', hide_cover: 'false', show_facepile: 'false',
})}`;
---
<BaseLayout title="Watch Online | Word of Faith Church of God" description="Watch Word of Faith Church of God services live on Facebook and YouTube, plus recent messages and past livestreams, then join us in person in Neptune, NJ.">
  <section class="py-20">
    <div class="container-shell max-w-4xl">
      <p class="eyebrow">Watch & worship</p>
      <h1 class="mt-3 font-display text-5xl font-bold text-wine-dark">Worship with us, wherever you are.</h1>
      <p class="mt-5 text-lg leading-8 text-stone-700">Sunday services are livestreamed on Facebook, and messages are shared on our YouTube channel. Watch along, then join us in person at {site.service}.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={site.facebook} target="_blank" rel="noopener">Watch on Facebook</a>
        <a class="btn border border-wine/25 text-wine-dark hover:bg-white" href={site.youtube} target="_blank" rel="noopener">Visit our YouTube</a>
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="container-shell grid max-w-5xl gap-8">
      <article class="card overflow-hidden">
        <div class="p-6 sm:p-8">
          <p class="eyebrow">YouTube</p>
          <h2 class="mt-2 font-display text-3xl font-bold text-wine-dark">Messages & livestreams</h2>
          <p class="mt-3 text-stone-700">Watch recent messages, catch a past livestream, or join us live on <a class="font-bold text-wine underline decoration-gold underline-offset-4" href={site.youtube} target="_blank" rel="noopener">@wordoffaithcog</a>.</p>
          <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Choose what to watch">
            {views.map((v, i) => <button type="button" class="yt-view rounded-full border border-wine/20 px-4 py-2 text-sm font-bold text-wine-dark transition hover:border-gold aria-pressed:border-wine aria-pressed:bg-wine aria-pressed:text-white" aria-pressed={i === 0 ? 'true' : 'false'} data-src={v.src} data-key={v.key}>{v.label}</button>)}
          </div>
          <p class="yt-live-note mt-3 hidden text-sm text-stone-600">If we're not live right now, the player will say so. Sunday services also stream on <a class="font-bold text-wine underline decoration-gold underline-offset-4" href={site.facebook} target="_blank" rel="noopener">Facebook</a>.</p>
        </div>
        <div id="yt-player" class="embed aspect-video bg-wine-dark" data-src={players.latest} data-title="Word of Faith Church of God on YouTube">
          <button type="button" class="embed-load group grid h-full w-full place-items-center p-6 text-center text-cream">
            <span>
              <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-gold text-wine-dark transition group-hover:scale-105" aria-hidden="true"><svg class="ml-1 h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              <span class="mt-4 block text-lg font-bold">Loading YouTube…</span>
            </span>
          </button>
        </div>
        {videos.length > 0 && (
          <div class="p-6 sm:p-8">
            <h3 class="font-display text-xl font-bold text-wine-dark">Recent uploads</h3>
            <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
              {videos.map((v) => (
                <li>
                  <button type="button" class="yt-video group block w-full text-left" data-src={videoEmbed(v.id)} data-title={v.title}>
                    <span class="block overflow-hidden rounded-lg bg-sand"><img class="aspect-video w-full object-cover transition group-hover:scale-105" src={thumbnail(v.id)} alt="" width="320" height="180" loading="lazy" decoding="async" /></span>
                    <span class="mt-2 line-clamp-2 block text-sm font-bold text-wine-dark group-hover:text-wine">{v.title}</span>
                    {v.published && <span class="block text-xs text-stone-500">{dateFmt.format(new Date(v.published))}</span>}
                  </button>
                </li>
              ))}
            </ul>
            <a class="mt-6 inline-block text-sm font-bold text-wine underline decoration-gold underline-offset-4" href={`${site.youtube}/videos`} target="_blank" rel="noopener">See all videos on YouTube</a>
          </div>
        )}
      </article>

      <article class="card overflow-hidden">
        <div class="p-6 sm:p-8">
          <p class="eyebrow">Facebook</p>
          <h2 class="mt-2 font-display text-3xl font-bold text-wine-dark">Livestream & updates</h2>
          <p class="mt-3 text-stone-700">Sunday services stream live on our <a class="font-bold text-wine underline decoration-gold underline-offset-4" href={site.facebook} target="_blank" rel="noopener">Facebook page</a>, along with church news.</p>
        </div>
        <div class="bg-sand px-4 py-8 sm:px-8">
          <div class="embed mx-auto h-[640px] w-full max-w-[500px] overflow-hidden rounded-xl bg-white shadow-sm" data-src={facebookEmbed} data-title="Word of Faith Church of God on Facebook">
            <button type="button" class="embed-load group grid h-full w-full place-items-center p-6 text-center text-wine-dark">
              <span>
                <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-wine text-xl font-black text-white transition group-hover:scale-105" aria-hidden="true">f</span>
                <span class="mt-4 block text-lg font-bold">Loading Facebook…</span>
              </span>
            </button>
          </div>
          <p class="mx-auto mt-4 max-w-[500px] text-center text-sm text-stone-700">Posts not showing? Some browsers block Facebook content on other sites. <a class="font-bold text-wine underline decoration-gold underline-offset-4" href={site.facebook} target="_blank" rel="noopener">Open our Facebook page</a>.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="bg-wine-dark py-16 text-cream">
    <div class="container-shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div><h2 class="font-display text-3xl font-bold">Ready to worship in person?</h2><p class="mt-2 text-cream/75">{site.service} at {site.address}.</p></div>
      <a class="btn btn-light" href="/visit">Plan Your Visit</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Embeds load as they scroll into view (or on tap), so the top of the page stays fast.
  function load(box: HTMLElement, src = box.dataset.src!, title = box.dataset.title!) {
    const frame = document.createElement('iframe');
    frame.src = src;
    frame.title = title;
    frame.className = 'h-full w-full border-0';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    box.replaceChildren(frame);
    box.dataset.loaded = 'true';
  }

  const boxes = document.querySelectorAll<HTMLElement>('.embed');
  const observer = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        observer?.unobserve(e.target);
        const box = e.target as HTMLElement;
        if (!box.dataset.loaded) load(box);
      }), { rootMargin: '300px' })
    : null;
  boxes.forEach((box) => {
    observer?.observe(box);
    box.querySelector('.embed-load')?.addEventListener('click', () => load(box), { once: true });
  });

  // YouTube: switch between latest uploads, past livestreams and the live player, or play one video.
  const player = document.getElementById('yt-player')!;
  const viewButtons = document.querySelectorAll<HTMLButtonElement>('.yt-view');
  const liveNote = document.querySelector('.yt-live-note');
  function show(src: string, title: string, active?: HTMLButtonElement) {
    viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === active)));
    liveNote?.classList.toggle('hidden', active?.dataset.key !== 'live');
    observer?.unobserve(player);
    load(player, src, title);
  }
  viewButtons.forEach((b) => b.addEventListener('click', () => show(b.dataset.src!, `YouTube: ${b.textContent}`, b)));
  document.querySelectorAll<HTMLButtonElement>('.yt-video').forEach((b) => b.addEventListener('click', () => {
    show(b.dataset.src!, b.dataset.title!);
    player.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
  }));
</script>
