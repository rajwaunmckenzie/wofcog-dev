---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Ministries | Word of Faith Church of God"><section class="py-20"><div class="container-shell"><p class="eyebrow">Grow & serve</p><h1 class="mt-3 font-display text-5xl font-bold text-wine-dark">Ministries & community</h1><div class="mt-10 grid gap-5 md:grid-cols-3"><article class="card p-6"><h2 class="text-2xl font-bold text-wine-dark">Bible Study</h2><p class="mt-3 text-stone-700">A place to learn Scripture and grow together. Thursdays at 6:00 PM on Zoom.</p></article><article class="card p-6"><h2 class="text-2xl font-bold text-wine-dark">Youth Night</h2><p class="mt-3 text-stone-700">Every other Friday at 7:00 PM at the church. Age details to be confirmed.</p></article><article class="card p-6"><h2 class="text-2xl font-bold text-wine-dark">Community Outreach</h2><p class="mt-3 text-stone-700">An annual effort on the second Saturday in August, focused on serving and giving back to the community.</p></article></div></div></section></BaseLayout>
